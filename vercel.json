{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/downloads/quicksign/QuickSign-Polished-Setup.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"QuickSign-Setup.exe\""
        }
      ]
    },
    {
      "source": "/downloads/image/MLDY-Image-v1.1.1-Windows.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"MLDY-Image-v1.1.1-Windows.zip\""
        }
      ]
    },
    {
      "source": "/downloads/image/MLDY-Image-Setup-v1.1.1.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"MLDY-Image-Setup-v1.1.1.exe\""
        }
      ]
    }
  ],
  "functions": {
    "api/visitors.mjs": {
      "maxDuration": 30
    }
  }
}
